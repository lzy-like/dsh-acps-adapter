# dsh-acps 环境变量示例。复制为 .env 并按需修改（.env 不入库）。

# Python 解释器（transport: sdk 时用于运行 acps-sdk 桥接进程）
ACPS_PYTHON=python

# 指向包含 acps_sdk 包的目录（pip install --target <dir> acps-sdk 后的目录）。
# 留空时桥接进程会自动向上查找 .pylibs；部署到 DSH profile 后建议显式设置。
# ACPS_SDK_PYTHONPATH=C:\path\to\pylibs

# DSH 家目录（默认 ~/.dsh）
# DSH_HOME=C:\Users\you\.dsh

# 可选：DeepSeek API Key（仅 headless 端到端验证需要；Web 模式走 DSH 自身凭据）
# DEEPSEEK_API_KEY=sk-...
